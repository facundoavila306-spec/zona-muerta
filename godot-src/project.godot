; Engine configuration file.
config_version=5

[application]
config/name="Zona Muerta"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.02, 0.025, 0.035, 1)

[autoload]
GS="*res://gs.gd"

[debug]
file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[input]
adelante={"deadzone":0.5,"events":[{"_type":"key","keycode":87}]}
atras={"deadzone":0.5,"events":[{"_type":"key","keycode":83}]}
izq={"deadzone":0.5,"events":[{"_type":"key","keycode":65}]}
der={"deadzone":0.5,"events":[{"_type":"key","keycode":68}]}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.02, 0.025, 0.035, 1)
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=2
occlusion_culling/use_occlusion_culling=false
